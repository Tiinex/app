    "pack:check": "npm pack --dry-run",
    "test:build": "vite build --config test/browser/vite.config.mjs",
    "validate": "npm test && npm run test:build"
  },
  "dependencies": {
    "@tiinex/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "19.2.7",
