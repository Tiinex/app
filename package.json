{
  "name": "@tiinex/app",
  "version": "0.1.0",
  "description": "Shared Tiinex application layer built on @tiinex/core \u2014 Viewer data plane, Verse hosting and reusable React application infrastructure.",
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.js",
    "./react": "./src/react.js",
    "./package.json": "./package.json",
    "./viewer": "./src/viewer.js",
    "./styles": "./src/styles/app.css",
    "./verse": "./src/verses/hostRegistry.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/CONSUMER-CONTRACT.md"
